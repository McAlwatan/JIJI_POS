<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_fv_icon_circle.xml — dark elevated tile behind each
     quick-action icon. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/fv_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/fv_stroke" />
        </shape>
    </item>
</ripple>