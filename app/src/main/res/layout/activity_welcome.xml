<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/shadow_background"
    android:orientation="vertical"
    android:padding="40dp"
    >

    <Button
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="@string/app_name"
        android:backgroundTint="@color/red"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="390dp"
        android:orientation="vertical"
        >

    </LinearLayout>
    <TextView
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_note"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:textSize="38sp"
        android:textColor="@color/white"
        android:fontFamily="@font/valleysans_variablefont_wght"
        android:layout_marginBottom="10dp"
        >
    </TextView>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/splash_desc"
        android:layout_marginBottom="30dp"
        android:textColor="@color/white"
        >
    </TextView>
    <Button
        android:id="@+id/splashLoginBtn"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        app:cornerRadius="13dp"
        android:text="@string/splashLoginBtn"
        android:backgroundTint="@color/red"
        >

    </Button>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="15dp">

    </LinearLayout>
    <Button
        android:id="@+id/splashRegisterBtn"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        app:cornerRadius="13dp"
        android:text="@string/splashRegisterBtn"
        android:backgroundTint="@color/white"
        android:textColor="@color/black"
        />

</LinearLayout>