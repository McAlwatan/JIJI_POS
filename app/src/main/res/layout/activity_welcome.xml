<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    tools:context=".WelcomeActivity">

    <!-- MASTER VERTICAL ALIGNMENT LAYER STACK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. UPPER SPACE FOR THE GEOMETRIC SHAPES GRAPHICS -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3">

            <!-- Gold Geometric Orb Shape -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/goldOrb"
                android:layout_width="130dp"
                android:layout_height="130dp"
                app:cardCornerRadius="65dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:backgroundTint="#DDA15E"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.2"
                app:layout_constraintVertical_bias="0.5" />

            <!-- White Circle Ring Outline Frame -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:cardCornerRadius="100dp"
                app:cardElevation="0dp"
                app:strokeColor="#25FFFFFF"
                app:strokeWidth="2dp"
                android:backgroundTint="@android:color/transparent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.8"
                app:layout_constraintVertical_bias="0.6" />

            <!-- Deep Orange Decorative Dot Shape -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:backgroundTint="#E65F2B"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="16dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. BRANDING APP LABEL -->
        <TextView
            android:id="@+id/textWelcomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JIJI POS."
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 3. SUBTITLE INFORMATION EXTRACTION BLOCK -->
        <TextView
            android:id="@+id/textWelcomeDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to Fair Invest Application.\nDo you have an account yet?"
            android:textColor="@color/white"
            android:alpha="0.7"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="44dp" />

        <!-- 4. BOTTOM INTERACTIVE NAV FOOTER CONTROL ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Solid Pastel Registration Button Key -->
            <Button
                android:id="@+id/btnSplashRegister"
                android:layout_width="0dp"
                android:layout_weight="1.1"
                android:layout_height="match_parent"
                android:text="Register"
                android:textColor="#0A0A0A"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="#CCE3DE"
                app:cornerRadius="30dp"
                android:layout_marginEnd="8dp"/>

            <!-- Outlined Login Button Key -->
            <Button
                android:id="@+id/btnSplashLogin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="0.9"
                android:layout_height="match_parent"
                android:text="Log In"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                app:strokeColor="#35FFFFFF"
                app:strokeWidth="1.5dp"
                app:cornerRadius="30dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
