<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/activity_register.xml
    Same fairvest system as activity_login.xml — same colors_fairvest,
    dimens_fairvest (+ sw600dp/land overrides), styles_fairvest, and the
    fv_input_stroke / fv_input_hint color selectors.

    All IDs match your original layout 1:1, so RegisterActivity needs no
    Java/Kotlin changes: buttonBack, registerName, registerPhone,
    spinnerRoles, layoutInvitationCode, inputInvitationCode,
    registerPassword, buttonRegisterSubmit, buttonGoogleSignUp,
    buttonAppleSignUp, buttonFacebookSignUp, textLoginLink.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fv_bg"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/registerContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/fv_screen_padding"
            android:paddingEnd="@dimen/fv_screen_padding"
            android:paddingTop="@dimen/fv_screen_padding"
            android:paddingBottom="@dimen/fv_gap_lg"
            app:layout_constraintWidth_max="@dimen/fv_content_max_width"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- ========== Back ========== -->
            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/fv_ink"
                android:background="@drawable/bg_fv_social"
                android:layout_marginBottom="@dimen/fv_gap_lg"
                android:contentDescription="@string/back" />

            <!-- ========== Heading ========== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/signUp"
                android:textSize="@dimen/fv_title_text"
                android:textColor="@color/fv_ink"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create your digital JIJI POS accounting profile"
                android:textColor="@color/fv_muted"
                android:textSize="@dimen/fv_subtitle_text"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="@dimen/fv_gap_lg" />

            <!-- ========== Form ========== -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Fairvest.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:layout_marginBottom="@dimen/fv_gap_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/registerName"
                    style="@style/Fairvest.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Fairvest.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:layout_marginBottom="@dimen/fv_gap_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/registerPhone"
                    style="@style/Fairvest.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Account Type"
                android:textColor="@color/fv_muted"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Spinner wrapped to match the input fields: flat surface,
                 rounded corners, idle/focus stroke via fv_input_stroke. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fv_spinner"
                android:layout_marginBottom="@dimen/fv_gap_sm">

                <Spinner
                    android:id="@+id/spinnerRoles"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:popupBackground="@color/fv_surface"
                    android:spinnerMode="dropdown" />
            </FrameLayout>

            <!-- Manager invitation token — hidden by default, shown when the
                 selected role requires it. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInvitationCode"
                style="@style/Fairvest.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Manager Invitation Token Code"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/fv_gap_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputInvitationCode"
                    style="@style/Fairvest.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Fairvest.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/fv_muted"
                android:layout_marginBottom="@dimen/fv_gap_lg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/registerPassword"
                    style="@style/Fairvest.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ========== Primary action ========== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRegisterSubmit"
                style="@style/Fairvest.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fv_button_height"
                android:text="Create account" />

            <!-- ========== Divider ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/fv_gap_lg"
                android:layout_marginBottom="@dimen/fv_gap_md">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/fv_stroke" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/or"
                    android:textSize="@dimen/fv_small_text"
                    android:textColor="@color/fv_muted"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/fv_stroke" />
            </LinearLayout>

            <!-- ========== Social ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/fv_gap_lg">

                <ImageButton
                    android:id="@+id/buttonGoogleSignUp"
                    android:layout_width="@dimen/fv_social_size"
                    android:layout_height="@dimen/fv_social_size"
                    android:background="@drawable/bg_fv_social"
                    android:src="@drawable/ic_google"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="@dimen/fv_social_gap"
                    android:contentDescription="@string/loginWithGoogle" />

                <ImageButton
                    android:id="@+id/buttonAppleSignUp"
                    android:layout_width="@dimen/fv_social_size"
                    android:layout_height="@dimen/fv_social_size"
                    android:background="@drawable/bg_fv_social"
                    android:src="@drawable/ic_apple"
                    app:tint="@color/fv_ink"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="@dimen/fv_social_gap"
                    android:contentDescription="@string/loginWithApple" />

                <ImageButton
                    android:id="@+id/buttonFacebookSignUp"
                    android:layout_width="@dimen/fv_social_size"
                    android:layout_height="@dimen/fv_social_size"
                    android:background="@drawable/bg_fv_social"
                    android:src="@drawable/ic_facebook"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/loginWithFacebook" />
            </LinearLayout>

            <!-- ========== Login link ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alreadyHaveAccount"
                    android:textColor="@color/fv_muted"
                    android:textSize="@dimen/fv_body_text" />

                <TextView
                    android:id="@+id/textLoginLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login"
                    android:textColor="@color/fv_accent"
                    android:textStyle="bold"
                    android:textSize="@dimen/fv_body_text"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>