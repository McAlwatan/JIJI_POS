<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <TextView
        android:id="@+id/textLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp" />

    <TextView
        android:id="@+id/textLockSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Security PIN"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textLockTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PIN dots indicator area -->
    <LinearLayout
        android:id="@+id/layoutPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/textLockSub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View android:id="@+id/dot1" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/bg_badge_circle_teal" android:alpha="0.2" />
        <View android:id="@+id/dot2" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/bg_badge_circle_teal" android:alpha="0.2" />
        <View android:id="@+id/dot3" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/bg_badge_circle_teal" android:alpha="0.2" />
        <View android:id="@+id/dot4" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/bg_badge_circle_teal" android:alpha="0.2" />
    </LinearLayout>

    <!-- Banking-style Numeric Grid Layout -->
    <GridLayout
        android:id="@+id/pinGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@id/layoutPinDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button style="@style/PinButton" android:text="1" android:tag="1" />
        <Button style="@style/PinButton" android:text="2" android:tag="2" />
        <Button style="@style/PinButton" android:text="3" android:tag="3" />

        <Button style="@style/PinButton" android:text="4" android:tag="4" />
        <Button style="@style/PinButton" android:text="5" android:tag="5" />
        <Button style="@style/PinButton" android:text="6" android:tag="6" />

        <Button style="@style/PinButton" android:text="7" android:tag="7" />
        <Button style="@style/PinButton" android:text="8" android:tag="8" />
        <Button style="@style/PinButton" android:text="9" android:tag="9" />

        <ImageButton
            android:id="@+id/btnBiometricUnlock"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_header_icon_circle"
            android:src="@android:drawable/ic_lock_idle_lock"
            app:tint="@color/white"
            android:padding="20dp"
            android:contentDescription="Fingerprint Unlock" />

        <Button style="@style/PinButton" android:text="0" android:tag="0" />

        <ImageButton
            android:id="@+id/btnDeletePin"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_header_icon_circle"
            android:src="@android:drawable/ic_input_delete"
            app:tint="@color/white"
            android:padding="20dp"
            android:contentDescription="Delete" />

    </GridLayout>

    <TextView
        android:id="@+id/textSwitchToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Use password to login"
        android:textColor="@color/teal_light"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
