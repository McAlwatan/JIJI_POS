<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/fragment_customer_home.xml
    This file didn't exist yet, so it's built fresh against exactly what
    CustomerHomeFragment.java binds via findViewById: chipToday/Week/Month/
    Year, textSpendAmount, textSpendLabel, cardGraphContainer,
    customerSpendingGraph, btnScanQr, actionMyReceipts, actionSpendingGraph,
    panelBackground.

    Root MUST stay a direct ConstraintLayout: the fragment casts
    panelBackground's LayoutParams to ConstraintLayout.LayoutParams and
    swaps its topToBottom target between R.id.cardGraphContainer and
    R.id.textSpendLabel when the graph is toggled — that only compiles if
    panelBackground's immediate parent is this ConstraintLayout.

    Dark theme throughout — the tray in activity_dashboard.xml is fv_surface
    (matching the hero card), so this uses fv_ink/fv_muted/fv_stroke like
    the rest of the app, not the light-surface tokens.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fv_surface">

    <!-- ========== Period chip selector ========== -->
    <LinearLayout
        android:id="@+id/chipRow"
        android:layout_width="0dp"
        android:layout_height="@dimen/fv_chip_height"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/fv_screen_padding"
        android:layout_marginEnd="@dimen/fv_screen_padding"
        android:layout_marginTop="@dimen/fv_gap_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/chipToday"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:text="Today"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipWeek"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:text="Week"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/chipMonth"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:text="Month"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/chipYear"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:text="Year"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- ========== Spend amount ========== -->
    <TextView
        android:id="@+id/textSpendAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fv_gap_lg"
        android:gravity="center"
        android:text="TSh 0"
        android:textColor="@color/fv_ink"
        android:textSize="@dimen/fv_amount_text"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/chipRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textSpendLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Spent today"
        android:textColor="@color/fv_muted"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/textSpendAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== Spending trend graph card (Selcom-Pesa style) ==========
         GONE by default — actionSpendingGraph toggles this AND moves
         panelBackground's top anchor between this card and textSpendLabel. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGraphContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fv_gap_md"
        android:layout_marginStart="@dimen/fv_screen_padding"
        android:layout_marginEnd="@dimen/fv_screen_padding"
        android:visibility="gone"
        app:cardBackgroundColor="@color/fv_stroke"
        app:cardCornerRadius="@dimen/fv_graph_card_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/textSpendLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spending trend"
                android:textColor="@color/fv_ink"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Custom view — bar/line rendering, colors and data points
                 are set programmatically by CustomerHomeFragment
                 (customerSpendingGraph.setData(...)). If you share
                 LineGraphView.java I can theme its stroke/fill colors to
                 match this palette (fv_accent line, fv_light_stroke grid). -->
            <com.example.jijipos.LineGraphView
                android:id="@+id/customerSpendingGraph"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fv_graph_height" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ========== Rounded panel behind the quick-actions row ==========
         Height is driven purely by its top constraint, which the fragment
         swaps at runtime — no fixed height needed here. -->
    <View
        android:id="@+id/panelBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_fv_panel_top"
        app:layout_constraintTop_toBottomOf="@id/textSpendLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ========== Quick actions row ========== -->
    <LinearLayout
        android:id="@+id/actionsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/fv_gap_lg"
        android:layout_marginStart="@dimen/fv_screen_padding"
        android:layout_marginEnd="@dimen/fv_screen_padding"
        app:layout_constraintTop_toTopOf="@id/panelBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnScanQr"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/fv_action_icon_size"
                android:layout_height="@dimen/fv_action_icon_size"
                android:background="@drawable/bg_fv_icon_circle"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/fv_ink"
                android:padding="16dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Scan QR"
                android:textColor="@color/fv_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionMyReceipts"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/fv_action_icon_size"
                android:layout_height="@dimen/fv_action_icon_size"
                android:background="@drawable/bg_fv_icon_circle"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/fv_ink"
                android:padding="16dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="My Receipts"
                android:textColor="@color/fv_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionSpendingGraph"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/fv_action_icon_size"
                android:layout_height="@dimen/fv_action_icon_size"
                android:background="@drawable/bg_fv_icon_circle"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/fv_ink"
                android:padding="16dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Spending"
                android:textColor="@color/fv_ink"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>