<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/activity_login.xml
    Dark "fairvest" styling. All IDs match your previous layout, so no
    Java/Kotlin changes are needed.

    Responsiveness:
      - ScrollView + fillViewport: never clips on short screens, never
        leaves a gap on tall ones, and survives the keyboard opening.
      - ConstraintLayout + layout_constraintWidth_max: the form centres and
        stops growing on tablets / foldables instead of stretching.
      - Every size comes from dimens, overridden in values-sw600dp and
        values-land.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fv_bg"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/loginContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/fv_screen_padding"
            android:paddingEnd="@dimen/fv_screen_padding"
            android:paddingTop="@dimen/fv_hero_top"
            android:paddingBottom="@dimen/fv_gap_lg"
            app:layout_constraintWidth_max="@dimen/fv_content_max_width"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- ========== Hero artwork ========== -->
            <ImageView
                android:id="@+id/imageLoginArt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/fv_hero_max_height"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_fv_hero"
                android:layout_marginBottom="@dimen/fv_hero_bottom"
                android:importantForAccessibility="no"
                android:contentDescription="@string/loginArtwork" />

            <!-- ========== Heading ========== -->
            <TextView
                android:id="@+id/textLoginTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login"
                android:textSize="@dimen/fv_title_text"
                android:textColor="@color/fv_ink"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/textLoginSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/loginDescription"
                android:textColor="@color/fv_muted"
                android:textSize="@dimen/fv_subtitle_text"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="@dimen/fv_gap_lg" />

            <!-- ========== Form ========== -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutPhone"
                style="@style/Fairvest.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/loginPhoneHint"
                android:layout_marginBottom="@dimen/fv_gap_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPhone"
                    style="@style/Fairvest.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutPassword"
                style="@style/Fairvest.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/loginPasswordHint"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/fv_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPassword"
                    style="@style/Fairvest.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ========== Remember me / Forgot ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/fv_gap_sm"
                android:layout_marginBottom="@dimen/fv_gap_md">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxRememberMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rememberMe"
                    android:textColor="@color/fv_muted"
                    android:textSize="@dimen/fv_small_text"
                    android:minWidth="0dp"
                    app:buttonTint="@color/fv_accent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/textForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgotPassword"
                    android:textColor="@color/fv_accent"
                    android:textStyle="bold"
                    android:textSize="@dimen/fv_small_text"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- ========== Primary action ========== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLogin"
                style="@style/Fairvest.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fv_button_height"
                android:text="@string/loginBtn" />

            <!-- ========== Divider ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/fv_gap_lg"
                android:layout_marginBottom="@dimen/fv_gap_md">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/fv_stroke" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/or"
                    android:textSize="@dimen/fv_small_text"
                    android:textColor="@color/fv_muted"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/fv_stroke" />
            </LinearLayout>

            <!-- ========== Social ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/fv_gap_lg">

                <ImageButton
                    android:id="@+id/buttonGoogleLogin"
                    android:layout_width="@dimen/fv_social_size"
                    android:layout_height="@dimen/fv_social_size"
                    android:background="@drawable/bg_fv_social"
                    android:src="@drawable/ic_google"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="@dimen/fv_social_gap"
                    android:contentDescription="@string/loginWithGoogle" />

                <ImageButton
                    android:id="@+id/buttonAppleLogin"
                    android:layout_width="@dimen/fv_social_size"
                    android:layout_height="@dimen/fv_social_size"
                    android:background="@drawable/bg_fv_social"
                    android:src="@drawable/ic_apple"
                    app:tint="@color/fv_ink"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="@dimen/fv_social_gap"
                    android:contentDescription="@string/loginWithApple" />

                <ImageButton
                    android:id="@+id/buttonFacebookLogin"
                    android:layout_width="@dimen/fv_social_size"
                    android:layout_height="@dimen/fv_social_size"
                    android:background="@drawable/bg_fv_social"
                    android:src="@drawable/ic_facebook"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/loginWithFacebook" />
            </LinearLayout>

            <!-- ========== Sign up ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dontHaveAccoun"
                    android:textColor="@color/fv_muted"
                    android:textSize="@dimen/fv_body_text" />

                <TextView
                    android:id="@+id/textSignUpLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/signUp"
                    android:textColor="@color/fv_accent"
                    android:textStyle="bold"
                    android:textSize="@dimen/fv_body_text"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>