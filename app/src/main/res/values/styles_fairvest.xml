<?xml version="1.0" encoding="utf-8"?>
<!-- res/values/styles_fairvest.xml (new file — no need to touch your styles.xml)
     Requires your app theme to be a Theme.MaterialComponents.* theme. -->
<resources>

    <style name="Fairvest.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/fv_surface</item>
        <item name="boxStrokeColor">@color/fv_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/fv_accent</item>
        <item name="android:textColorHint">@color/fv_input_hint</item>
        <item name="boxCornerRadiusTopStart">@dimen/fv_input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/fv_input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/fv_input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/fv_input_radius</item>
        <item name="endIconTint">@color/fv_muted</item>
        <item name="errorTextColor">@color/fv_orange</item>
        <item name="boxStrokeErrorColor">@color/fv_orange</item>
    </style>

    <style name="Fairvest.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/fv_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- filled pale-blue pill: primary action -->
    <style name="Fairvest.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/fv_button_text</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/fv_on_accent</item>
        <item name="backgroundTint">@color/fv_accent</item>
        <item name="cornerRadius">@dimen/fv_pill_radius</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33000000</item>
    </style>

    <!-- Top-rounded / square-bottom card shape. MaterialCardView has no
         cardCornerRadiusTopStart/TopEnd/etc. attributes — those only exist
         on plain CardView. This is the correct replacement, applied via
         app:shapeAppearanceOverlay on the MaterialCardView. -->
    <style name="ShapeAppearance.Fairvest.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- outlined pill: secondary action -->
    <style name="Fairvest.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/fv_button_text</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/fv_ink</item>
        <item name="strokeColor">@color/fv_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/fv_pill_radius</item>
        <item name="rippleColor">@color/fv_ripple</item>
    </style>

    <!-- ===== Light-tray variants: for forms sitting on the WHITE lower
         tray (New Sale, and any future light-context form) — the plain
         Fairvest.TextInput/EditText above assume the black hero card and
         would render a near-black input box on a white card. ===== -->

    <style name="Fairvest.TextInput.Light" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/fv_light_surface</item>
        <item name="boxStrokeColor">@color/fv_light_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/fv_accent</item>
        <item name="android:textColorHint">@color/fv_light_input_hint</item>
        <item name="boxCornerRadiusTopStart">@dimen/fv_input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/fv_input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/fv_input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/fv_input_radius</item>
        <item name="endIconTint">@color/fv_light_muted</item>
        <item name="errorTextColor">@color/fv_orange</item>
        <item name="boxStrokeErrorColor">@color/fv_orange</item>
    </style>

    <style name="Fairvest.EditText.Light" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/fv_light_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>
</resources>