<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         SHARED — referenced directly by Java, not just XML. Never
         rename or remove without also updating the matching code:
           - R.color.white / R.color.text_muted are read in
             CustomerHomeFragment.java's chip-selection logic.
         ============================================================ -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="text_muted">#9E9E9E</color>


    <!-- ============================================================
         FAIRVEST DESIGN SYSTEM (fv_*) — the current standard. Every
         new screen should build from these, not the legacy section
         below.
         ============================================================ -->
    <color name="fv_bg">#0A0A0A</color>          <!-- screen background -->
    <color name="fv_surface">#151515</color>     <!-- inputs, social buttons -->
    <color name="fv_stroke">#272727</color>      <!-- idle borders, elevated card/row fill -->
    <color name="fv_ink">#FFFFFF</color>         <!-- primary text -->
    <color name="fv_muted">#9B9B9B</color>       <!-- secondary text, hints -->
    <color name="fv_accent">#C6DCE6</color>      <!-- pale blue: primary action -->
    <color name="fv_on_accent">#0A0A0A</color>   <!-- text on pale blue -->
    <color name="fv_gold">#D9B14C</color>
    <color name="fv_orange">#F05A28</color>
    <color name="fv_orange_soft">#1FF05A28</color> <!-- translucent fv_orange — destructive rows (Logout) -->
    <color name="fv_ripple">#22C6DCE6</color>

    <!-- Solid accent used for selected chips AND the trend-graph line —
         unlike fv_accent (very pale, meant to pair with DARK text), this
         is saturated enough that hardcoded WHITE text (set in Java)
         stays readable on any dark surface. Also used for icon tints
         (Settings/Profile) that want the same accent identity. -->
    <color name="fv_chip_accent">#2F6FED</color>

    <!-- Light-surface tokens: kept in reserve for any future white-card
         element (e.g. the QR display), NOT the default theme — every
         screen so far uses the dark fv_* tokens above. -->
    <color name="fv_light_ink">#111111</color>
    <color name="fv_light_muted">#6E6E6E</color>
    <color name="fv_light_surface">#F3F3F3</color>
    <color name="fv_light_stroke">#E7E7E7</color>
    <color name="fv_dark_pill">#171717</color>   <!-- unused now that chips use fv_chip_accent -->


    <!-- ============================================================
